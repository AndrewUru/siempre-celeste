{
  "name": "siempre-celeste",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --outDir dist/client && node scripts/build-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local --config dist/server/wrangler.json --persist-to .wrangler/state",
    "preview": "wrangler dev --local --config dist/server/wrangler.json --persist-to .wrangler/state",
    "prebuild": "node scripts/clean-build.mjs"
  },
  "dependencies": {
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "wrangler": "^4.158.0"
  }
}
