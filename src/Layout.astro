---
import { ClientRouter } from 'astro:transitions';
const {title} = Astro.props;
---
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#faf7ec"/><title>{title} · Siempre Celeste</title><link rel="icon" href="/logo.webp"/><ClientRouter/></head>
<body><header><a class="brand" href="/"><img src="/logo.webp" width="40" height="38" alt=""/>Siempre Celeste</a><nav aria-label="Navegación principal"><a class="navlink" href="/#repertorio">Cancionero</a><a class="navlink" href="/editar/">Añadir canción</a><a class="navlink" href="/guia/">Guía</a></nav></header><slot/><footer>Murga Siempre Celeste <span>Cancionero de ensayo</span></footer></body></html>
<style is:global>
:root{color-scheme:light;--ink:#142e38;--paper:#faf7ec;--blue:#b9ddec;font-family:'DM Sans',Arial,sans-serif;color:var(--ink);background:var(--paper)}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,footer{display:flex;justify-content:space-between;align-items:center;padding:14px max(5vw,20px);border-bottom:1px solid #142e3833}header a{text-decoration:none}.brand{display:flex;gap:12px;align-items:center;font:bold 20px Georgia,serif}.brand img{object-fit:contain}.navlink{font-size:14px;border-bottom:1px solid}.navlink:hover{color:#27728a}footer{margin-top:64px;border-top:1px solid #142e3833;font-size:13px}button,input,select{font:inherit}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #13758c;outline-offset:3px}
header nav{display:flex;gap:clamp(12px,2vw,28px);flex-wrap:wrap;align-items:center}header{gap:10px;flex-wrap:wrap}@media(max-width:560px){header{align-items:flex-start}header nav{padding:6px 0}.brand img{width:32px;height:30px}} </style>

